{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexumotion",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",

  // nodejs_compat is required: Prisma and the Neon driver both use Node APIs.
  // The *_v2 flag lets Node built-ins resolve without an explicit "node:" prefix.
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // Non-secret runtime values must live here, not only in the dashboard: a
  // deploy re-applies this file and drops any plain var it does not declare.
  // Both of these were set through the dashboard and silently disappeared on
  // the next git-triggered deploy. Secrets are managed separately and are not
  // affected.
  //
  // AUTH_TRUST_HOST: NextAuth sits behind Cloudflare's proxy, so it has to be
  // told the forwarded host is trustworthy or callback URLs are rejected.
  //
  // NEXT_PUBLIC_SITE_URL: also needs to exist as a *build* variable, because
  // NEXT_PUBLIC_* is inlined into client bundles at build time — this entry
  // only covers server-side reads such as sitemap.ts.
  // D1 replaces the Neon Postgres this used to reach over the network. Neon's
  // free tier meters compute time — it bills for how long the database is
  // awake — and constant scanner traffic on always-dynamic pages exhausted the
  // allowance and took the site down. D1 bills rows read, and runs inside
  // Cloudflare rather than across the Atlantic.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexumotion",
      "database_id": "a92919f7-faab-464a-bef4-442b6dee5ed2"
    }
  ],

  // Outbound mail, native to the platform. Workers have no TCP sockets, so SMTP
  // is impossible here and the alternative was a third-party HTTP API (Resend),
  // which meant another account, another key to rotate and another free tier to
  // run out of.
  //
  // `destination_address` pins the binding to a single recipient. Cloudflare
  // will only deliver to an address verified under Email Routing → Destination
  // Addresses, and this is the one verified address on the account.
  // technical@nexumotion.com already forwards here, so notifications land in
  // the same inbox either way — this just skips a hop that can fail.
  "send_email": [
    {
      "name": "SEND_EMAIL",
      "destination_address": "remahxautomation@gmail.com"
    }
  ],

  "vars": {
    "AUTH_TRUST_HOST": "true",
    "NEXT_PUBLIC_SITE_URL": "https://nexumotion.com"
  }

  // DATABASE_URL, AUTH_SECRET and ADMIN_PASSWORD are secrets, not plain vars.
  // Set them with:  npx wrangler secret put DATABASE_URL
  // Do not add them here — this file is committed.
}
